<%- include("partials/head") %>
<%- include("partials/nav") %>

  <main>
    <!-- Hero -->
    <div class="container">
      <div class="hero-banner">
        <span class="eyebrow">Contact</span>
        <h1>Let's work together</h1>
        <p>Recruiting for an enrollment at RP or student life opportunities, or seeking part-time work during school? I'd love to hear from you.</p>
        <div class="btn-row">
          <a class="btn" href="#message">Send a Message</a>
          <% if (hasResume) { %>
          <a class="btn btn-outline" href="/files/TM_Linn_Resume.pdf" download>Download Resume</a>
          <% } else { %>
          <a class="btn btn-outline" href="/portfolio">View My Work</a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- May I help you -->
    <section id="message">
      <div class="container project-detail-grid">
        <div class="card">
          <h2>May I help you?</h2>
          <% if (sent) { %>
          <p class="form-note show" role="status">Thanks! Your message has been received — I'll get back to you soon.</p>
          <% } %>
          <% if (formError) { %>
          <p class="form-error" role="alert"><%= formError %></p>
          <% } %>
          <form id="contact-form" method="post" action="/contact#message">
            <div class="form-grid">
              <div class="form-group">
                <label for="name">Name</label>
                <input id="name" name="name" type="text" maxlength="100" value="<%= values.name || '' %>" required />
                <% if (errors.name) { %><span class="form-error"><%= errors.name %></span><% } %>
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" maxlength="254" value="<%= values.email || '' %>" required />
                <% if (errors.email) { %><span class="form-error"><%= errors.email %></span><% } %>
              </div>
              <div class="form-group full">
                <label for="reason">I'm reaching out about</label>
                <select id="reason" name="reason">
                  <% reasons.forEach((reason) => { %>
                  <option <%= values.reason === reason ? 'selected' : '' %>><%= reason %></option>
                  <% }) %>
                </select>
                <% if (errors.reason) { %><span class="form-error"><%= errors.reason %></span><% } %>
              </div>
              <div class="form-group full">
                <label for="message-text">Message</label>
                <textarea id="message-text" name="message" maxlength="2000" required><%= values.message || '' %></textarea>
                <% if (errors.message) { %><span class="form-error"><%= errors.message %></span><% } %>
              </div>
              <!-- Honeypot: hidden from people, catches spam bots -->
              <div class="form-trap" aria-hidden="true">
                <label for="website">Leave this empty</label>
                <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
            </div>
            <div class="btn-row"><button class="btn" type="submit">Send Message</button></div>
          </form>
        </div>

        <aside class="card">
          <h3>Other ways to reach me</h3>
          <ul class="contact-info">
            <li><strong>Email</strong><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
            <li><strong>LinkedIn</strong><a href="<%= site.linkedin %>" target="_blank" rel="noopener">View my LinkedIn</a></li>
            <li><strong>GitHub</strong><a href="<%= site.github %>" target="_blank" rel="noopener">View my GitHub</a></li>
            <li><strong>Based in</strong><%= site.location %></li>
          </ul>
        </aside>
      </div>
    </section>
  </main>

<%- include("partials/footer") %>
